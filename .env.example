# ─── App ────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_KEY=generate_a_strong_random_key_here

# ─── Database ───────────────────────────────────────────
# On Railway: set to the ${{Postgres.DATABASE_URL}} reference variable
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Redis ──────────────────────────────────────────────
# On Railway: set to the ${{Redis.REDIS_URL}} reference variable
REDIS_URL=redis://default:password@host:6379

# ─── Twilio ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ─── Webhooks (set after Railway gives you a public URL) ─
TWILIO_WEBHOOK_URL=https://your-app.railway.app/webhooks/twilio/inbound
TWILIO_STATUS_CALLBACK=https://your-app.railway.app/webhooks/twilio/status
