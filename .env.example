# Twilio Credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Webhook URLs (must be publicly accessible, e.g. via ngrok in dev)
TWILIO_WEBHOOK_URL=https://yourdomain.com/webhooks/twilio/inbound
TWILIO_STATUS_CALLBACK=https://yourdomain.com/webhooks/twilio/status

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sms_db

# Redis (for BullMQ queue)
REDIS_URL=redis://localhost:6379

# App
PORT=3000
NODE_ENV=development

# API Security
API_KEY=your_secret_api_key_here
